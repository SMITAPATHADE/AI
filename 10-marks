Q 9: Write a program to solve the Tower of Hanoi Problem using state-space representation.

Python Program:


# Tower of Hanoi using State-Space Representation 
def tower_of_hanoi(n, source, auxiliary, destination, state):
 
 # Base condition
 if n == 0:
 return
 # Move n-1 disks from source to auxiliary
 tower_of_hanoi(n - 1, source, destination, auxiliary, state)
 # Move the largest disk to destination
 print("Move disk", n, "from", source, "to", destination)
 # Update state
 state[n - 1] = destination
 print("State:", tuple(state))
 # Move n-1 disks from auxiliary to destination
 tower_of_hanoi(n - 1, auxiliary, source, destination, state)
# Number of disks
n = 3
# Initial state: all disks are on A
state = ['A'] * n
print("Initial State:", tuple(state))
print("\nSteps:")
tower_of_hanoi(n, 'A', 'B', 'C', state)
print("\nGoal State:", tuple(state))


