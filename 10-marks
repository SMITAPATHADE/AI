from collections import deque
# State-space graph
graph = {
 'A': ['B', 'C'],
 'B': ['A', 'D'],
 'C': ['A', 'E'],
 'D': ['B', 'E'],
 'E': ['C', 'D']
}
def bfs(start):
 visited = set() 
 queue = deque()
 # Add start vertex
 queue.append(start)
 visited.add(start)
 print("BFS Traversal:")
 while queue:
 vertex = queue.popleft()
 print(vertex, end=" ")
 # Visit all adjacent states
for neighbour in graph[vertex]:
 if neighbour not in visited:
 visited.add(neighbour)
 queue.append(neighbour)
# Start BFS from A
bfs('A')


