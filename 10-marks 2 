Q1 : Write a program to implement the A* Search Algorithm to find the shortest path between 
a source node and a destination node.
Python Program


import heapq 
# Graph with edge costs
graph = {
 'A': [('B', 1), ('C', 1)],
 'B': [('D', 1), ('E', 1)],
 'C': [('F', 1)],
 'D': [],
 'E': [],
 'F': []
}
# Heuristic values: estimated cost to reach F
heuristic = {
 'A': 2,
 'B': 3,
 'C': 1,
 'D': 4,
 'E': 4,
 'F': 0
}
def a_star(source, destination):
 # Priority queue: (f, g, node, path)
 open_list = []
 heapq.heappush(open_list, (heuristic[source], 0, source, [source]))
 visited = set()
 while open_list:
 f, g, current, path = heapq.heappop(open_list)
 if current in visited:
 continue
 visited.add(current)
 # Destination reached
 if current == destination:
 return path, g
 # Explore neighbouring nodes
 for neighbour, cost in graph[current]:
 if neighbour not in visited:
 new_g = g + cost
 new_f = new_g + heuristic[neighbour]
 heapq.heappush 
open_list,
 (new_f, new_g, neighbour, path + [neighbour])
 )
 return None, None
# Source and destination
source = 'A'
destination = 'F'
path, cost = a_star(source, destination)
print("Source Node:", source)
print("Destination Node:", destination)
print("Shortest Path:", " -> ".join(path))
print("Path Cost:", cost)


Output
Source Node: A
Destination Node: F
Shortest Path: A -> C -> F
Path Cost: 2

Q2 : Write the program to implement the AO* Algorithm
Python Program :


# AO* Algorithm for AND-OR Graph
graph = {
 'A': {
 'type': 'OR',
 'children': [('B', 2), ('C', 3)]
 },
 'B': {
 'type': 'AND',
 'children': [('D', 1), ('E', 4)]
 },
 'C': { 
 'type': 'OR',
 'children': [('F', 2), ('G', 5)]
 },
 'D': {
 'type': 'OR',
 'children': [('H', 2), ('I', 3)]
 },
 'E': {
 'type': 'OR',
 'children': [('J', 1)]
 },
 # Goal nodes
 'F': {'type': 'GOAL', 'children': []},
 'G': {'type': 'GOAL', 'children': []},
 'H': {'type': 'GOAL', 'children': []},
 'I': {'type': 'GOAL', 'children': []},
 'J': {'type': 'GOAL', 'children': []}
}
def ao_star(node):
 # If node is a goal node
 if graph[node]['type'] == 'GOAL':
 return 0, [node]
 children = graph[node]['children']
 if graph[node]['type'] == 'OR':
 # Choose the child having minimum cost
 best_cost = float('inf')
 best_path = None
 for child, edge_cost in children:
 child_cost, child_path = ao_star(child)
 total_cost = edge_cost + child_cost
 if total_cost < best_cost:
 best_cost = total_cost
 best_path = [node] + child_path
 return best_cost, best_path
 elif graph[node]['type'] == 'AND':
 # All children must be solved 
 total_cost = 0
 path = [node]
 for child, edge_cost in children:
 child_cost, child_path = ao_star(child)
 total_cost += edge_cost + child_cost
 path += child_path
 return total_cost, path
# Start AO* from node A
cost, solution = ao_star('A')
print("AO* Solution:")
print(" -> ".join(solution))
print("Total Cost:", cost)


