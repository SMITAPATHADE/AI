Q5 : Write a program to implement the Best First Search Algorithm using heuristic values to 
find a path from a start node to a goal node
Python Program:


import heapq
# Graph with edge costs
graph = {
 'A': [('B', 2), ('C', 4)],
 'B': [('A', 2), ('D', 3), ('E', 5)],
 'C': [('A', 4), ('F', 1)],
 'D': [('B', 3), ('F', 2)],
 'E': [('B', 5), ('F', 1)],
 'F': [('C', 1), ('D', 2), ('E', 1)]
}
# Heuristic values
heuristic = {
 'A': 6,
 'B': 5,
 'C': 3,
 'D': 2,
 'E': 1,
 'F': 0
}
def best_first_search(start, goal):
 # Priority queue: (heuristic, node, path)
 open_list = []
 heapq.heappush(open_list, (heuristic[start], start, [start]))
 visited = set()
 while open_list:
 h, current, path = heapq.heappop(open_list)
 if current in visited:
 continue
 visited.add(current)
 print("Visiting:", current, "h =", heuristic[current])
 # Goal test
 if current == goal:
 return path
 # Add unvisited neighbours
 for neighbour, cost in graph[current]:
 if neighbour not in visited:
 heapq.heappush(
 open_list,
 (heuristic[neighbour], neighbour, path + [neighbour])
 )
 return None
# Start and goal
start = 'A'
goal = 'F'
path = best_first_search(start, goal)
print("\nBest First Search Path:")
print(" -> ".join(path))



