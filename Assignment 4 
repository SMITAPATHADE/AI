Q5 : Write a program to implement the Minimax Algorithm for a two-player game.

Program

# Program to implement Minimax Algorithm
# for a Two-Player Game
# Minimax function
def minimax(node, maximizing_player):
 # If the node is a leaf node
 if isinstance(node, int):
 return node
 # MAX player's turn
 if maximizing_player:
 best_value = float('-inf')
 for child in node:
 value = minimax(child, False)
 best_value = max(best_value, value)
 return best_value
 # MIN player's turn
 else:
 best_value = float('inf')
 for child in node:
 value = minimax(child, True)
 best_value = min(best_value, value)
 return best_value
# Game Tree
# A (MAX)
# / \
# B (MIN) C (MIN) PROF
# / \ / \
# 3 5 2 9
game_tree = [
 [3, 5],
 [2, 9]
]
# Find the optimal value
optimal_value = minimax(game_tree, True)
# Display result
