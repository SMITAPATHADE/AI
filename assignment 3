Q3: Write a program to solve the N-Queens Problem using the Backtracking Algorithm.

python program:-

def safe(board, r, c):
 for i in range(r):
 # Check column and diagonal
 if board[i] == c or abs(board[i] - c) == abs(i - r):
 return False
 return True
def solve(board, r, n):
 # All queens are placed
 if r == n:
 return True
 # Try each column
 for c in range(n):
 if safe(board, r, c):
 board[r] = c
 # Move to the next row
 if solve(board, r + 1, n):
 return True
 # Backtrack
 board[r] = -1
 return False
# Number of queens
n = 4
# Initialize board
board = [-1] * n # Solve the problem
if solve(board, 0, n):
 print("Solution:")
 for r in range(n):
 print(" ".join("Q" if board[r] == c else "."
 for c in range(n)))
else:
