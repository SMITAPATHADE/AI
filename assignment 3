Q1: Write a program to solve the Map Coloring Problem using the Constraint Satisfaction 
Problem (CSP) approach. 
 

Python Program :
# Map Coloring using CSP
# Variables
variables = ['A', 'B', 'C', 'D']
# Available colors
colors = ['Red', 'Green', 'Blue']
# Neighbours of each region
neighbors = {
 'A': ['B', 'C'],
 'B': ['A', 'D'],
 'C': ['A', 'D'],
 'D': ['B', 'C']
}
# Check whether assigning a color is valid
def is_valid(region, color, assignment):
 for neighbour in neighbors[region]:
 if neighbour in assignment:
 if assignment[neighbour] == color:
 return False return True
# CSP Backtracking
def solve(assignment):
 # All regions are colored
 if len(assignment) == len(variables):
 return assignment
 # Select an unassigned region
 for region in variables:
 if region not in assignment:
 # Try each color
 for color in colors:
 if is_valid(region, color, assignment):
 assignment[region] = color
 result = solve(assignment)
 if result:
 return result
 # Backtrack
 del assignment[region]
 return None
# Solve the CSP
solution = solve({})
# Display solution
if solution:
 print("Map Coloring Solution:")
 for region in variables:
 print(region, "->", solution[region])
else:
 print("No solution exists.")

Output
Map Coloring Solution:
A -> Red
B -> Green
C -> Green
D -> Red


Q2 : Write a program to implement the Backtracking Algorithm for solving a constraint 
satisfaction problem.
 
Python Program :
# Backtracking Algorithm for CSP
# Graph Coloring Problem
# Vertices
vertices = [1, 2, 3, 4, 5]
# Available colors
colors = ['Red', 'Green', 'Blue', 'Yellow', 'Orange']
# Graph: every vertex is connected to every other vertex
graph = {
 1: [2, 3, 4, 5],
 2: [1, 3, 4, 5],
 3: [1, 2, 4, 5],
 4: [1, 2, 3, 5],
 5: [1, 2, 3, 4]
}
# Check whether assigning a color is safe
def is_safe(vertex, color, assignment):
 for neighbour in graph[vertex]:
 if neighbour in assignment:
 if assignment[neighbour] == color:
 return False
 return True # Backtracking function
def backtracking(assignment):
 # All vertices are assigned
 if len(assignment) == len(vertices):
 return True
 # Select an unassigned vertex
 for vertex in vertices:
 if vertex not in assignment:
 # Try each available color
 for color in colors:
 if is_safe(vertex, color, assignment):
 # Assign color
 assignment[vertex] = color
 # Recursively solve
 if backtracking(assignment):
 return True
 # Backtrack
 del assignment[vertex]
 return False
 return False
# Start with empty assignment
assignment = {}
if backtracking(assignment):
 print("Solution:")
 for vertex in vertices:
 print("Vertex", vertex, "->", assignment[vertex])
else:
 print("No solution exists.")


Output
Solution:
Vertex 1 -> Red
Vertex 2 -> Green
Vertex 3 -> Blue
Vertex 4 -> Yellow
