Q1) Write a program to implement Propositional Logic and evaluate logical expressions using 
operators such as AND, OR, and NOT.

Program

# Program to implement Propositional Logic
# using AND, OR, and NOT operators
# Function to evaluate logical expressions
def evaluate_logic(P, Q):
 print("P =", P)
 print("Q =", Q)
 print("P AND Q =", P and Q)
 print("P OR Q =", P or Q)
 print("NOT P =", not P)
 print("NOT Q =", not Q)
# Main program
print("Evaluation of Logical Expressions")
print("----------------------------------")
P = True
Q = False
evaluate_logic(P, Q)
# Generate Truth Table
print("\nTruth Table")
print("----------------------------------")
print("P\tQ\tP AND Q\tP OR Q\tNOT P")
values = [True, False]
for P in values:
 for Q in values:
 print(P, "\t", Q, "\t", P and Q,
 "\t", P or Q, "\t", not P)

Output
Evaluation of Logical Expressions
----------------------------------
P = True
Q = False
P AND Q = False
P OR Q = True 
NOT P = False
NOT Q = True
Truth Table
----------------------------------
P Q P AND Q P OR Q NOT P
True True True True False
True False False True False
False True False True True
False False False False True


Q2 : Write a program to implement Predicate Logic using predicates, variables, and quantifier.

Program

# Program to implement Predicate Logic
# using Predicates, Variables and Quantifiers
# Objects
students = ["Rahul", "Isha", "Atharva"]
# Predicate
def is_student(name):
 return name in students
# Predicate for checking whether a student passed
passed_students = ["Rahul", "Isha", "Atharva"]
def has_passed(name):
 return name in passed_students
# Variable
x = "Rahul"
print("Predicate Logic")
print("----------------")
# Predicate evaluation
print("Is", x, "a student?", is_student(x))
# Universal Quantifier (∀)
# Check whether all students have passed
all_passed = all(has_passed(student) for student in students)
print("\nUniversal Quantifier (∀):")
print("All students have passed:", all_passed)
# Existential Quantifier (∃)
# Check whether at least one student has passed
some_passed = any(has_passed(student) for student in students)
print("\nExistential Quantifier (∃):")
print("There exists a student who has passed:", some_passed)

Output
Predicate Logic
----------------
Is Rahul a student? True
Universal Quantifier (∀):
All students have passed: True
Existential Quantifier (∃):
There exists a student who has passed: True


